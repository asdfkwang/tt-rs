# tt-atlantis minimal (base: riscv defconfig)
CONFIG_MODULES=y
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_WATCHDOG=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_IP_TUNNEL=n
CONFIG_INET_TUNNEL=n
CONFIG_IPV6_SIT=n
CONFIG_NET_SELFTESTS=n
CONFIG_PHYLIB=n
CONFIG_FIXED_PHY=n
CONFIG_FWNODE_MDIO=n
CONFIG_OF_MDIO=n
CONFIG_ACPI_MDIO=n
CONFIG_SPACEMIT_K1_EMAC=n
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_HWMON=y
CONFIG_RUST=y
CONFIG_KUNIT=y
CONFIG_RUST_KERNEL_DOCTESTS=y
CONFIG_TENSTORRENT_BH_RUST=y
